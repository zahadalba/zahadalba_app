############################################
# OS / SYSTEM
############################################
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

############################################
# IDE / EDITORS
############################################
.vs/
.idea/
.fleet/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

############################################
# ENVIRONMENT / SECRETS
############################################
.env
.env.*
!.env.example
!.env.*.example

# .NET User Secrets and local secret files
secrets.json
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json

# Private keys and certificates
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer

############################################
# LOGS
############################################
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

############################################
# NODE.JS / NUXT
############################################
**/node_modules/
**/.nuxt/
**/.output/
**/.data/
**/.cache/
**/.nitro/
**/.temp/
**/.vite/
**/dist/
**/coverage/

# Nuxt generated declarations
**/nuxt.d.ts
**/auto-imports.d.ts
**/components.d.ts

############################################
# PACKAGE MANAGERS
############################################
# Keep the lockfile for the package manager actually used.
# Do NOT ignore package-lock.json, pnpm-lock.yaml or yarn.lock.

############################################
# ASP.NET CORE / .NET
############################################
**/bin/
**/obj/
**/TestResults/
**/artifacts/
**/publish/

# Local IDE / tooling
*.rsuser
*.sln.ide

############################################
# ENTITY FRAMEWORK CORE
############################################
# IMPORTANT:
# Do NOT ignore Migrations, ModelSnapshot or Designer.cs files.
# EF Core migrations are source code and must be committed.

############################################
# BUILD OUTPUTS
############################################
# Do not globally ignore DLL, EXE, PDB or CACHE extensions.
# Ignore build output directories above instead.

############################################
# PUBLISH / DEPLOYMENT
############################################
# Local publish profiles can contain credentials.
**/Properties/PublishProfiles/*.pubxml
**/Properties/PublishProfiles/*.publishsettings

############################################
# TEST / COVERAGE
############################################
coverage/
**/TestResults/
*.coverage
*.coveragexml
*.opencover.xml

############################################
# DOCKER LOCAL OVERRIDES
############################################
docker-compose.override.yml
docker-compose.*.override.yml

############################################
# TEMPORARY FILES
############################################
*.tmp
*.temp
*.bak
*.orig
*.rej
